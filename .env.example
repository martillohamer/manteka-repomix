# ---------------------------------------------------------------------------
# Environment template — copy to `.env` and fill in real values.
#
#   cp .env.example .env        # .env is git-ignored and must never be committed
#
# Every value below is intentionally EMPTY or a placeholder. Never put a real
# secret in this file: it IS tracked by Git on purpose, so that contributors know
# which knobs exist without any credential ever reaching the repository.
# ---------------------------------------------------------------------------

# === Website server — Cloudflare Turnstile (CAPTCHA on /api/pack) ===========
# Server-side secret used to verify tokens. Fail-closed in production, fail-open
# in dev/test. Ref: website/server/src/middlewares/turnstile.ts
TURNSTILE_SECRET_KEY=

# Public site key rendered by the client widget. This one is NOT a secret.
# Ref: website/client/.vitepress/config.ts
VITE_TURNSTILE_SITE_KEY=

# === Website server — Upstash Redis (daily rate limiting) ====================
# Both values are required for the limiter to activate; if either is missing the
# limiter disables itself and logs a notice.
# Ref: website/server/src/utils/dailyRateLimit.ts
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# === Website server — origin guard ===========================================
# Shared secret compared in constant time against the `x-origin-secret` header.
# When unset the guard is skipped entirely (dev/migration period).
# Ref: website/server/src/middlewares/cloudflareGuard.ts
CLOUDFLARE_ORIGIN_SECRET=

# === Core CLI / MCP server (optional, non-secret) ============================
# Operational knobs. None of these are credentials.

# Log verbosity: trace | debug | info | warn | error
REPOMIX_LOG_LEVEL=

# Token-count cache toggle and its on-disk location.
# NOTE: despite the name, these hold no secret — only a cache flag/path.
REPOMIX_TOKEN_CACHE=
REPOMIX_TOKEN_CACHE_PATH=

# Remote repository config trust. Required for --trust-config in remote flows.
REPOMIX_REMOTE_TRUST_CONFIG=

# Worker execution strategy and asset locations.
REPOMIX_WORKER_TYPE=
REPOMIX_WORKER_PATH=
REPOMIX_WASM_DIR=

# Standard Node.js mode.
NODE_ENV=development